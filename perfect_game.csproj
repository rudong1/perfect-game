<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>perfect_game</RootNamespace>
  </PropertyGroup>

  <!-- Runtime dependencies of the Godot-MCP addon (see addons/godot_mcp/nuget-deps.json). -->
  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.5.0" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="8.13.1" />
  </ItemGroup>

  <!-- Editor-only dependencies: they must not leak into export builds. -->
  <ItemGroup Condition="'$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'">
    <PackageReference Include="com.IvanMurzak.Rql" Version="0.1.1" />
    <PackageReference Include="com.IvanMurzak.CodeExec" Version="0.2.1" />
    <PackageReference Include="com.IvanMurzak.CodeExec.Roslyn" Version="0.2.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <!-- Required so the addon's Extensions panel can read its catalog at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>
</Project>
