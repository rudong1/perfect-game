[gd_resource type="Theme" format=3 uid="uid://c6cwl4ujolgrf"]

[sub_resource type="SystemFont" id="Serif"]
font_names = PackedStringArray("EB Garamond", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", "Noto Serif", "DejaVu Serif")
font_weight = 400

[sub_resource type="GDScript" id="LeadPanelScript"]
script/source = "extends StyleBox\n@export var surface := Color(0.043137, 0.047059, 0.062745, 0.88)\nfunc _get_minimum_size() -> Vector2:\n\treturn Vector2(24, 24)\nfunc _draw(item: RID, rect: Rect2) -> void:\n\tvar gold := Color(0.788235, 0.635294, 0.152941, 0.5)\n\tRenderingServer.canvas_item_add_rect(item, rect, surface)\n\tvar corners := [rect.position, Vector2(rect.end.x, rect.position.y), rect.end, Vector2(rect.position.x, rect.end.y)]\n\tfor i in 4:\n\t\tRenderingServer.canvas_item_add_line(item, corners[i], corners[(i + 1) % 4], gold, 1.0, true)\n\tfor corner in [rect.position + Vector2(7, 7), Vector2(rect.end.x - 7, rect.position.y + 7), rect.end - Vector2(7, 7), Vector2(rect.position.x + 7, rect.end.y - 7)]:\n\t\tRenderingServer.canvas_item_add_line(item, corner - Vector2(3, 0), corner + Vector2(3, 0), gold, 1.0, true)\n\t\tRenderingServer.canvas_item_add_line(item, corner - Vector2(0, 3), corner + Vector2(0, 3), gold, 1.0, true)\n"

[sub_resource type="StyleBox" id="LeadPanel"]
content_margin_left = 18.0
content_margin_top = 12.0
content_margin_right = 18.0
content_margin_bottom = 12.0
script = SubResource("LeadPanelScript")

[resource]
default_font = SubResource("Serif")
default_font_size = 20
Label/colors/font_color = Color(0.909804, 0.890196, 0.827451, 1)
